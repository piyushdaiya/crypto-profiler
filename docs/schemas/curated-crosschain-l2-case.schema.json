{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-profiler.local/schemas/curated-crosschain-l2-case.schema.json",
  "title": "Crypto Profiler Curated Cross-Chain L2 Case",
  "description": "Schema for curated Phase 3 cross-chain L2 cases built from the normalized L2 feature mart.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_family",
    "case_id",
    "title",
    "description",
    "chains_included",
    "member_count",
    "members",
    "crosschain_summary",
    "curation_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "case_family": {
      "type": "string",
      "const": "crosschain_l2"
    },
    "case_id": {
      "type": "string",
      "enum": [
        "crosschain-l2-repeated-contract-service-pattern",
        "crosschain-l2-broad-operational-hub",
        "crosschain-l2-stablecoin-bridge-operational-surface"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "chains_included": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "OPTIMISM",
          "POLYGON",
          "ARBITRUM"
        ]
      }
    },
    "member_count": {
      "type": "integer",
      "minimum": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/memberRow"
      }
    },
    "crosschain_summary": {
      "$ref": "#/$defs/crosschainSummary"
    },
    "curation_notes": {
      "$ref": "#/$defs/curationNotes"
    }
  },
  "$defs": {
    "memberRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "address",
        "tx_count",
        "inbound_count",
        "outbound_count",
        "unique_counterparties",
        "dominant_contract_share",
        "failure_rate_pct",
        "unique_emitters",
        "unique_topic0s",
        "bridge_hit_count",
        "protocol_hit_count",
        "stablecoin_hit_count",
        "service_hit_count",
        "top_bridge_family",
        "top_protocol_family",
        "top_stablecoin_family"
      ],
      "properties": {
        "chain": {
          "type": "string",
          "enum": [
            "OPTIMISM",
            "POLYGON",
            "ARBITRUM"
          ]
        },
        "address": {
          "type": "string",
          "pattern": "^0x[a-f0-9]{40}$"
        },
        "tx_count": {
          "type": "integer",
          "minimum": 0
        },
        "inbound_count": {
          "type": "integer",
          "minimum": 0
        },
        "outbound_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_counterparties": {
          "type": "integer",
          "minimum": 0
        },
        "dominant_contract_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "failure_rate_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "unique_emitters": {
          "type": "integer",
          "minimum": 0
        },
        "unique_topic0s": {
          "type": "integer",
          "minimum": 0
        },
        "bridge_hit_count": {
          "type": "integer",
          "minimum": 0
        },
        "protocol_hit_count": {
          "type": "integer",
          "minimum": 0
        },
        "stablecoin_hit_count": {
          "type": "integer",
          "minimum": 0
        },
        "service_hit_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_bridge_family": {
          "type": "string"
        },
        "top_protocol_family": {
          "type": "string"
        },
        "top_stablecoin_family": {
          "type": "string"
        }
      }
    },
    "crosschainSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address_count",
        "chain_count"
      ],
      "properties": {
        "address_count": {
          "type": "integer",
          "minimum": 1
        },
        "chain_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "total_tx_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_dominant_contract_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "max_unique_counterparties": {
          "type": "integer",
          "minimum": 0
        },
        "bridge_or_stablecoin_member_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["max_dominant_contract_share"]
          },
          "then": {
            "properties": {
              "max_dominant_contract_share": {
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "required": ["max_unique_counterparties"]
          },
          "then": {
            "properties": {
              "max_unique_counterparties": {
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "required": ["bridge_or_stablecoin_member_count"]
          },
          "then": {
            "properties": {
              "bridge_or_stablecoin_member_count": {
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "curationNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrative",
        "selection_basis"
      ],
      "properties": {
        "narrative": {
          "type": "string",
          "minLength": 1
        },
        "selection_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "case_id": {
            "const": "crosschain-l2-repeated-contract-service-pattern"
          }
        },
        "required": ["case_id"]
      },
      "then": {
        "properties": {
          "crosschain_summary": {
            "required": [
              "address_count",
              "chain_count",
              "total_tx_count",
              "max_dominant_contract_share"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_id": {
            "const": "crosschain-l2-broad-operational-hub"
          }
        },
        "required": ["case_id"]
      },
      "then": {
        "properties": {
          "crosschain_summary": {
            "required": [
              "address_count",
              "chain_count",
              "total_tx_count",
              "max_unique_counterparties"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_id": {
            "const": "crosschain-l2-stablecoin-bridge-operational-surface"
          }
        },
        "required": ["case_id"]
      },
      "then": {
        "properties": {
          "crosschain_summary": {
            "required": [
              "address_count",
              "chain_count",
              "total_tx_count",
              "bridge_or_stablecoin_member_count"
            ]
          }
        }
      }
    }
  ]
}